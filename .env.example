# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (server-only) — used for the Supabase Auth email
# confirmation redirect (emailRedirectTo). Example: https://app.example.com
APP_URL=https://your-app.example.com

# Google OAuth (server-only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/callback/gmail

# Microsoft OAuth (server-only)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/email/callback/outlook

# Server-only secret used to encrypt OAuth tokens
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Server-only secret shared with the external email worker
EMAIL_WORKER_SECRET=replace-with-a-long-random-secret

# AI provider (server-only; OpenAI-compatible API)
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=your-model-name
AI_VISION_MODEL=your-vision-model-name
AI_PROVIDER=custom

# AI Deckblatt Generator — Pollinations image API key (server-only),
# used for openai/gpt-image-2 via POST /v1/images/edits (the applicant's
# portrait is sent as the model's image input). Without it,
# /api/deckblatt/generate answers a clear "design service not configured"
# error (nothing is charged, the quota is not consumed).
# Server-side only; never exposed to the browser.
POLLINATIONS_API_KEY=your-pollinations-api-key

# Bundesagentur für Arbeit Jobsuche API client ID (server-side; documented default is jobboerse-jobsuche)
ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche

# Web discovery for AI Ausbildung Search (server-only; OPTIONAL).
# Without a usable key the web layer is skipped and the official BA source
# still works.
# Tavily Search API key — the ONLY key the web-search provider reads.
# Create one at https://app.tavily.com/ (server-side only; never exposed to
# the browser). At most 30 Tavily requests are made per search operation by
# default (the hard cost cap is 60 and can never be exceeded).
TAVILY_API_KEY=your-tavily-api-key
# Optional: the per-search-operation Tavily request budget. Positive integer,
# clamped into [1, 60]; leave empty to use the safe default (30).
TAVILY_MAX_REQUESTS_PER_RUN=

 # ---------------------------------------------------------------------------
# Housing "Wohnen" — on-demand live web search (server-side; OPTIONAL).
#
# MULTI-PROVIDER discovery engine (2026-10-10): finds current rental
# listings via paid web searches, on an explicit user click only.
#   GOOGLE  — Gemini API with the official google_search grounding tool
#             (broad discovery; per-executed-query billing).
#   AZURE   — Azure AI Foundry "web_search" tool with Bing grounding
#             (complementary; the targeted-mode path).
# Either provider may run ALONE (graceful degradation); both need nothing
# else. With neither configured the UI shows an honest "not configured"
# state and nothing is charged. (TAVILY_API_KEY above is used by the
# Germany Copilot, NOT by this feature.)
#
# Provider selection: only "azure" is supported (the default). Any other
# value is ignored with a warning. Leave empty for the default.
HOUSING_WEB_SEARCH=azure
#
# Azure config (server-only). The endpoint must be the Foundry Responses
# base in one of the two documented forms (the app appends /responses):
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.services.ai.azure.com/openai/v1
# If AZURE_WEB_SEARCH_ENDPOINT is empty, the
# existing AI_API_URL / AI_API_KEY / AI_MODEL are reused when AI_API_URL
# is itself a valid Foundry Responses base. All three must resolve for
# Azure to be "ready" (endpoint + key + model deployment with the
# web_search tool, e.g. gpt-5-mini):
AZURE_WEB_SEARCH_ENDPOINT=
AZURE_WEB_SEARCH_KEY=
AZURE_WEB_SEARCH_MODEL=
#
# Per-USER daily search quota (strict, server-side, Europe/Berlin calendar
# day). Positive integer; built-in default 20 searches per user per day.
# Stored in Postgres (migration 20261107000000_housing_web_search_quota);
# changing this value takes effect for new searches without a migration.
# (The per-USER hourly rate limit is separate: 10 searches/hour, see
# src/lib/rate-limit.ts.)
HOUSING_WEB_SEARCH_DAILY_MAX=
#
# GOOGLE provider (server-side only — NEVER in NEXT_PUBLIC_*, logs or
# responses). The Gemini API key enables the official google_search
# grounding tool (AI Studio key). Missing/empty → the engine runs
# Azure-only and reports Google as "not configured" (graceful).
GEMINI_API_KEY=
# Gemini model with grounding support (default: gemini-3.8-flash — the
# current Flash model in the official supported-models table). Only names
# from that table work; an unknown name yields HTTP 404 / NOT_FOUND.
# Documented options: gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3-flash-preview, gemini-2.5-flash.
HOUSING_GEMINI_MODEL=
# Estimated-cost cap per search run on the Google side, in cents
# (built-in default 50; env may only LOWER it, never raise).
HOUSING_SEARCH_MAX_COST_CENTS_PER_RUN=

# ---------------------------------------------------------------------------
# Community voice (Phase 4) — LiveKit SFU (server-side only; OPTIONAL).
#
# ALL three values are required for voice to work; with any of them missing
# the voice UI shows a clear "voice is not available yet" state (the token
# route answers 503). Nothing here is exposed to the browser: the SFU API
# secret is used ONLY to sign short-lived join tokens server-side, and the
# browser ever receives { url (wss endpoint — not a credential), room
# (server-derived from the room id), token (10-min, join + audio only) }.
# Create a cluster at https://cloud.livekit.io (or run your own SFU).
LIVEKIT_URL=your-livekit-wss-url
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

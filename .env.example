# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (server-only) — used for the Supabase Auth email
# confirmation redirect (emailRedirectTo). Example: https://app.example.com
APP_URL=https://your-app.example.com

# Google OAuth (server-only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/callback/gmail

# Microsoft OAuth (server-only)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/email/callback/outlook

# Server-only secret used to encrypt OAuth tokens
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Server-only secret shared with the external email worker
EMAIL_WORKER_SECRET=replace-with-a-long-random-secret

# AI provider (server-only; OpenAI-compatible API)
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=your-model-name
AI_VISION_MODEL=your-vision-model-name
AI_PROVIDER=custom

# AI Deckblatt Generator — Pollinations image API key (server-only),
# used for openai/gpt-image-2 via POST /v1/images/edits (the applicant's
# portrait is sent as the model's image input). Without it,
# /api/deckblatt/generate answers a clear "design service not configured"
# error (nothing is charged, the quota is not consumed).
# Server-side only; never exposed to the browser.
POLLINATIONS_API_KEY=your-pollinations-api-key

# Bundesagentur für Arbeit Jobsuche API client ID (server-side; documented default is jobboerse-jobsuche)
ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche

# Web discovery for AI Ausbildung Search (server-only; OPTIONAL).
# Without a usable key the web layer is skipped and the official BA source
# still works.
# Tavily Search API key — the ONLY key the web-search provider reads.
# Create one at https://app.tavily.com/ (server-side only; never exposed to
# the browser). At most 30 Tavily requests are made per search operation by
# default (the hard cost cap is 60 and can never be exceeded).
TAVILY_API_KEY=your-tavily-api-key
# Optional: the per-search-operation Tavily request budget. Positive integer,
# clamped into [1, 60]; leave empty to use the safe default (30).
TAVILY_MAX_REQUESTS_PER_RUN=
# Optional: how many ADDITIONAL pages the agentic site pass may open per
# company by following the site's own contact/career links (Kontakt /
# Impressum / Karriere / Jobs / Ausbildung / Bewerbung / Team). Allow-listed,
# same-origin, capped 0–5; leave empty for the safe default (3). The fixed
# required pages always keep their priority.
DISCOVERY_MAX_DISCOVERED_PAGES=
# Optional: how many of the provider's result pages may be fetched per company
# to identify its OFFICIAL website (Job portal → employer identity → official
# domain). A result host only counts as official when a fetched page on it
# literally names the company — nothing is guessed. Clamped into [0, 3]; leave
# empty for the safe default (2).
DISCOVERY_MAX_SITE_RESOLUTION_PAGES=
# Optional: how many of the company's own pages the email pass fetches per
# company (Impressum, Kontakt, Karriere, Jobs, Ausbildung, Team — in that
# order). Clamped into [0, 6]; leave empty for the safe default (6: all of
 # them, the original §4.7 ceiling).
DISCOVERY_MAX_EMAIL_PAGES=
 # ---------------------------------------------------------------------------
 # Camofox browser engine (server-only; OPTIONAL).
 # The research pipeline is HTTP-first: plain `fetch` + robots + SSRF guards.
 # When a page is a JavaScript shell / bot wall / captcha (content plain HTTP
 # cannot see), it is escalated ONCE to the anti-detection Camofox browser —
 # and the company deep crawl (career/ausbildung/bewerbung/kontakt/impressum,
 # "load more", pagination) runs in a reusable browser session.
 # Without a reachable engine the run is EXACTLY the legacy HTTP-only run.
 #
 # Root of the camofox-browser REST server (default http://127.0.0.1:9377).
 # Set to `disabled` (or empty) to turn the browser engine off.
 CAMOFOX_URL=http://127.0.0.1:9377
 # Bearer key when the server is protected by CAMOFOX_ACCESS_KEY (else empty).
 CAMOFOX_ACCESS_KEY=
 # Per-request timeout against the browser, ms (clamped ≤ 120000; default 45000).
 CAMOFOX_TIMEOUT_MS=
 # Browser pages the whole run may load (default 100, hard cap 300).
 DISCOVERY_MAX_BROWSER_PAGES=
 # Browser pages per single company during its deep crawl (default 8, cap 15).
 DISCOVERY_MAX_BROWSER_PAGES_PER_COMPANY=
 # Link depth of the company deep crawl, 0 = homepage only (default 3, cap 5).
 DISCOVERY_MAX_CRAWL_DEPTH=
 # In-page interactions per company (clicks/scrolls for lazy listings; default
 # 8, cap 16). The run's interaction budget is 2× its page budget.
 DISCOVERY_MAX_BROWSER_INTERACTIONS_PER_COMPANY=
 # Google Gemini API key (AI Studio) — reserved for other Gemini services in
 # this project; the web-search provider no longer reads it.
 GEMINI_API_KEY=your-gemini-api-key

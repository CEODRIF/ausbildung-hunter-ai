# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (safe for browser use with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (server-only) — used for the Supabase Auth email
# confirmation redirect (emailRedirectTo). Example: https://app.example.com
APP_URL=https://your-app.example.com

# Google OAuth (server-only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/callback/gmail

# Microsoft OAuth (server-only)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/email/callback/outlook

# Server-only secret used to encrypt OAuth tokens
EMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Server-only secret shared with the external email worker
EMAIL_WORKER_SECRET=replace-with-a-long-random-secret

# AI provider (server-only; OpenAI-compatible API)
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=your-model-name
AI_VISION_MODEL=your-vision-model-name
AI_PROVIDER=custom

# AI Deckblatt Generator — Pollinations image API key (server-only),
# used for openai/gpt-image-2 via POST /v1/images/edits (the applicant's
# portrait is sent as the model's image input). Without it,
# /api/deckblatt/generate answers a clear "design service not configured"
# error (nothing is charged, the quota is not consumed).
# Server-side only; never exposed to the browser.
POLLINATIONS_API_KEY=your-pollinations-api-key

# Bundesagentur für Arbeit Jobsuche API client ID (server-side; documented default is jobboerse-jobsuche)
ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche

# Web discovery for AI Ausbildung Search (server-only; OPTIONAL).
# Without a usable key the web layer is skipped and the official BA source
# still works.
# Tavily Search API key — the ONLY key the web-search provider reads.
# Create one at https://app.tavily.com/ (server-side only; never exposed to
# the browser). At most 3 Tavily requests are made per search operation.
TAVILY_API_KEY=your-tavily-api-key
# Google Gemini API key (AI Studio) — reserved for other Gemini services in
# this project; the web-search provider no longer reads it.
GEMINI_API_KEY=your-gemini-api-key
